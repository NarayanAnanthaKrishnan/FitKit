# Copy this file to .env for local development. Never commit .env.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/fitkit
FITKIT_API_KEY=<local-api-key>
TELEGRAM_BOT_TOKEN=<development-bot-token>
TELEGRAM_WEBHOOK_SECRET=<long-random-webhook-secret>
# Public URL used to build /connect-health and /dashboard links.
PUBLIC_BASE_URL=https://<your-deployed-host>
# Optional rollout/security toggles:
# ALLOW_LEGACY_INGEST_AUTH=0   # default 0; set 1 only while legacy Health Auto
#                              # Export users still use the global API-key bridge
# ACTION_CONFIRM_TTL_SECONDS=900
# DASHBOARD_LINK_TTL_SECONDS=900

# Groq LLM pilot (provider-neutral gateway; Groq is the selected pilot backend)
# GROQ_API_KEY=<groq-api-key>
# GROQ_MODEL=qwen/qwen3-32b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_ENABLED=1
# LLM_TIMEOUT_MS=8000
# LLM_MAX_OUTPUT_TOKENS=512
