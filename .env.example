# Copy to .env; keep credentials out of source control and shell history.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@127.0.0.1:5432/fitkit
# Compose uses this password to construct its internal database URL.
POSTGRES_PASSWORD=<URL-safe-random-password>
FITKIT_PRODUCTION=0
FITKIT_API_KEY=<local-api-key>
TELEGRAM_BOT_TOKEN=<development-bot-token>
TELEGRAM_WEBHOOK_SECRET=<long-random-webhook-secret>
PUBLIC_BASE_URL=https://<your-deployed-host>
# Generate a Fernet key; see docs/operations.md. Required in API and worker.
FITKIT_QUEUE_KEY=<generated-fernet-key>
# Use a different Fernet key for durable confirmed preference memory in production.
FITKIT_MEMORY_KEY=<different-generated-fernet-key>
# Required when FITKIT_PRODUCTION=1; comma-separated numeric Telegram IDs.
FITKIT_BETA_USER_IDS=
ALLOW_LEGACY_INGEST_AUTH=0
ACTION_CONFIRM_TTL_SECONDS=900
DASHBOARD_LINK_TTL_SECONDS=900
# Used only with the optional Compose tls profile (fullchain.pem + privkey.pem).
FITKIT_TLS_DIR=./local-certs

# Global availability; each user must also opt in with /preferences ai on.
TELEGRAM_CONVERSATION_V2=0
LLM_ENABLED=0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_MS=8000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_DAILY_LIMIT_PER_USER=50
LLM_GLOBAL_DAILY_LIMIT=500
# Keep FITKIT_BACKUP_KEY separately in the operator's secret store.
